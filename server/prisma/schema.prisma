// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles that can be assigned to registered users
enum Role {
  USER
  ADMIN
}

// Stores account details and securely hashed passwords
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  googleId     String?  @unique
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A user can own multiple notes
  notes        Note[]
}

// Each note belongs to exactly one user
model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  category  String   @default("General")
  isPinned  Boolean  @default(false)
  userId    Int

  // Remove user notes if their account is deleted
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Many-to-many relationship with tags
  tags      Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Available note categories
model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
}

// A tag can belong to multiple notes
model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  notes Note[]
}
